# Donation configuration — this file is a TEMPLATE.
# Copy to .env (gitignored, never committed) and fill in your values:
#
#   cp .env.example .env
#
# Priority: a valid silent payment address WINS over the xpub flow.
# With neither set, builds use a clearly-invalid placeholder QR on the back cover.

# Option 1 (highest priority): BIP 352 silent payment address (e.g. Cake Wallet).
BITCOIN_SILENT_PAYMENT_ADDRESS=

# Option 2: BIP84 account xpub (m/84'/0'/0'). Each release derives the next
# bc1 receive address from it (counter in donation-derive-state.json).
BITCOIN_DONATION_XPUB=
