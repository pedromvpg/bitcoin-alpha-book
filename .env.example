# Donation configuration — this file is a TEMPLATE.
# Copy to .env (which is gitignored and never committed) and fill in your real
# BIP 352 silent payment address from a supporting wallet (e.g. Cake Wallet).
#
#   cp .env.example .env
#
# Without it, builds use a clearly-invalid placeholder QR on the back cover.

BITCOIN_SILENT_PAYMENT_ADDRESS=sp1...
