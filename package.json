{
  "name": "bitcoin-alpha-book",
  "version": "1.0.0",
  "description": "Bitcoin v0.01 Alpha — annotated edition (line-by-line commentary, not source-only)",
  "type": "module",
  "scripts": {
    "fetch": "node scripts/fetch-source.js",
    "fetch:versions": "node scripts/fetch-versions.js",
    "validate": "node scripts/validate-annotations.mjs",
    "build": "node scripts/validate-annotations.mjs && node scripts/build.js",
    "preview": "node scripts/build-cover.js --preview-donation && node scripts/preview.js",
    "pdf": "node scripts/generate-pdf.js",
    "cover": "node scripts/build-cover.js",
    "cover:pdf": "node scripts/generate-cover-pdf.js",
    "test": "node scripts/test-index.js",
    "test:index": "node scripts/test-index.js",
    "debug:index": "node scripts/debug-index-pages.js",
    "thumbnails": "node scripts/generate-thumbnails.js",
    "donation:silent": "node scripts/donation-silent.js",
    "release": "node scripts/release.js",
    "ship": "node scripts/release.js && node scripts/preview.js"
  },
  "dependencies": {
    "adm-zip": "^0.5.10",
    "bip32": "^5.0.1",
    "bitcoinjs-lib": "^7.0.1",
    "express": "^4.18.2",
    "js-yaml": "^4.1.0",
    "pagedjs": "^0.4.3",
    "prismjs": "^1.29.0",
    "puppeteer": "^21.11.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.34.5",
    "tiny-secp256k1": "^2.2.4",
    "upng-js": "^2.1.0"
  },
  "devDependencies": {
    "open": "^10.0.0"
  }
}
